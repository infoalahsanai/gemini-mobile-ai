{
  "manifest_version": 3,
  "name": "Gemini Mobile & Web AI",
  "version": "1.0.0",
  "description": "Google Gemini AI Extension & Mobile Web App with dynamic multi-model selection",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini AI"
  },
  "icons": {
    "512": "icon512.png"
  }
}
